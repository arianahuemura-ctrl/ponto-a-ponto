# Ambiente da aplicação: production ou development. Refaça o build após alterar.
PAP_ENVIRONMENT=production

# Credencial privada, carregada apenas pelo backend Django.
# Gere a chave no portal de desenvolvedores da SPTrans.
SPTRANS_TOKEN=
# Opcional: caminho absoluto do índice GTFS (padrão: sptrans.sqlite3 na raiz).
# SPTRANS_DATABASE=/caminho/ponto-a-ponto/sptrans.sqlite3



# Branch de busca: catálogo 16/8/4; usa RAPTOR quando o par não está preparado.
SPTRANS_PLANNER=connections
# Orçamento suave de consultas ao Olho Vivo por busca (segundos).
SPTRANS_CONNECTION_API_BUDGET=20

# Configuração do planejamento e da geração de artefatos.
# Edite os valores particulares no .env; reinicie os processos após alterações.
# Limite por ligação de caminhada, em metros.
PAP_WALK_LIMIT_METERS=1000
# Velocidade de referência para calcular o tempo a pé.
PAP_WALK_SPEED_KMH=4.5
# Limite técnico das consultas de caminhada.
PAP_WALK_MAX_DISTANCE_METERS=5000
# Distância máxima entre cada parada e a rede pedestre.
PAP_WALK_SNAP_METERS=20
# Margem do recorte geográfico em graus.
PAP_OSM_MARGIN_DEGREES=0.025
# Tarefas simultâneas da compilação nativa.
PAP_OSRM_BUILD_JOBS=2
# Threads do pré-processamento e servidor OSRM.
PAP_OSRM_THREADS=4
# Consultas pedestres simultâneas (1 a 16).
PAP_WALK_WORKERS=4
# Destinos por consulta à matriz OSRM.
PAP_WALK_BATCH_SIZE=150
# Coordenadas por matriz; deve exceder o tamanho do lote.
PAP_OSRM_MAX_TABLE_SIZE=200
# Tempo máximo para iniciar o roteador.
PAP_OSRM_STARTUP_SECONDS=120
# Timeout de cada consulta ao roteador local.
PAP_WALK_REQUEST_SECONDS=60
# Quota materializada de trajetos com um ônibus.
PAP_ROUTES_DIRECT=16
# Quota materializada de trajetos com dois ônibus.
PAP_ROUTES_TWO_BUSES=8
# Quota materializada de trajetos com três ônibus.
PAP_ROUTES_THREE_BUSES=4
# Margem para transferência, além da caminhada e da espera.
PAP_TRANSFER_SECONDS=120
# Espera intermediária usada na classificação preliminar.
PAP_INTERMEDIATE_WAIT_SECONDS=300
# Quantidade máxima de alternativas finais.
PAP_RESULT_LIMIT=5
# Quantidade inicial de candidatos a refinar.
PAP_INITIAL_REFINEMENT=10
# Horizonte temporal da busca.
PAP_HORIZON_SECONDS=21600
# Prazo offline por par/categoria; não é o prazo da cidade inteira.
PAP_ROUTE_SECONDS=600
# Reserva de espaço livre para gerar artefatos.
PAP_MIN_FREE_GIB=5
# Versão e fonte de dados do roteador nativo.
PAP_OSRM_VERSION=6.0.0
PAP_OSM_PBF_URL=https://download.geofabrik.de/south-america/brazil/sudeste-latest.osm.pbf


# Evita embarques curtos e permite concluir a viagem a pé.
PAP_MIN_BUS_RIDE_METERS=300
PAP_FINAL_WALK_LIMIT_METERS=1500
